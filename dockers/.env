# ---------------------------------------------------------
# General Environment Settings
# ---------------------------------------------------------

# Set the timezone for the application
TIMEZONE=Asia/Bangkok

# Ensures logs are flushed immediately
PYTHONUNBUFFERED=1

KADOE_PORT=8000

# ---------------------------------------------------------
# Security
# ---------------------------------------------------------

# SECRET_KEY is used for JWT signing / session security.
# If omitted, the app uses a default **development** key.
# For production, ALWAYS set a strong unique value.
# SECRET_KEY="your-strong-secret-key"


# ---------------------------------------------------------
# Default Admin User
# ---------------------------------------------------------

# ADMIN_USER="admin"
# ADMIN_PASS="pass"
# ADMIN_EMAIL="admin@example.com"
# ADMIN_NAME="Super Admin"


# ---------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------

# You can choose ONE of the two approaches:
# 1) Provide a full URI (recommended for production)
# 2) Provide individual fields (host, user, pass, etc.)

# If all your services run on the same host/IP, set it here.
# Individual HOST variables override this if provided.
# DBS_SERVER_HOST="127.0.0.1"

# ---------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------

# Full connection URI
KADOE_POSTGRES_URI="postgresql+psycopg2://user:password@127.0.0.1:5432/ka_doe_db"

# --- OR ---

# KADOE_POSTGRES_HOST="postgres"
# KADOE_POSTGRES_PORT="5432"
# KADOE_POSTGRES_USER="user"
# KADOE_POSTGRES_PASS="password"
# KADOE_POSTGRES_DB="ka_doe_db"


# ---------------------------------------------------------
# MinIO
# ---------------------------------------------------------

# Full MinIO endpoint
KADOE_MINIO_URI="http://127.0.0.1:9000"

# --- OR ---

# KADOE_MINIO_HOST="minio"
# KADOE_MINIO_PORT="9000"

# MinIO access credentials
# KADOE_MINIO_USER="minioadmin"
# KADOE_MINIO_PASS="minioadmin"


# ---------------------------------------------------------
# MongoDB
# ---------------------------------------------------------

# Full connection URI
KADOE_MONGO_URI="mongodb://user:password@127.0.0.1:27017/ka_doe_db"

# --- OR ---

# KADOE_MONGO_HOST="mongo"
# KADOE_MONGO_PORT="27017"
# KADOE_MONGO_USER="user"
# KADOE_MONGO_PASS="password"
# KADOE_MONGO_DB="ka_doe_db"
